{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated administrator profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Opportunity": {
      "title": "Opportunity",
      "description": "Discovered Ausbildung opportunity in Germany",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "englishSummary": { "type": "string" },
        "companyName": { "type": "string" },
        "city": { "type": "string" },
        "postalCode": { "type": "string" },
        "bundesland": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "trainingType": { "type": "string" },
        "startYear": { "type": "integer" },
        "startDate": { "type": "string" },
        "applicationDeadline": { "type": "string" },
        "salary": { "type": "string" },
        "languageRequirement": { "type": "string" },
        "qualifications": { "type": "string" },
        "description": { "type": "string" },
        "applicationUrl": { "type": "string" },
        "companyWebsite": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "verificationStatus": { "type": "string" },
        "firstDiscoveredAt": { "type": "string" },
        "lastVerifiedAt": { "type": "string" },
        "isSaved": { "type": "boolean" },
        "applicationStatus": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["title", "companyName", "city", "category", "startYear"]
    },
    "Application": {
      "title": "Application",
      "description": "Personal tracked Ausbildung application record",
      "type": "object",
      "properties": {
        "opportunityId": { "type": "string" },
        "companyName": { "type": "string" },
        "positionTitle": { "type": "string" },
        "city": { "type": "string" },
        "bundesland": { "type": "string" },
        "status": { "type": "string" },
        "applicationDate": { "type": "string" },
        "followUpDate": { "type": "string" },
        "interviewDate": { "type": "string" },
        "contactPerson": { "type": "string" },
        "contactEmail": { "type": "string" },
        "notes": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["companyName", "positionTitle", "status"]
    },
    "ScanLog": {
      "title": "ScanLog",
      "description": "Radar automated search execution log",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "citiesCovered": { "type": "array" },
        "companiesDiscovered": { "type": "integer" },
        "opportunitiesVerified": { "type": "integer" },
        "durationSeconds": { "type": "integer" },
        "status": { "type": "string" },
        "details": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["timestamp", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile"
    },
    "/users/{userId}/opportunities/{opportunityId}": {
      "schema": "Opportunity",
      "description": "Ausbildung opportunities saved or discovered by user"
    },
    "/users/{userId}/applications/{applicationId}": {
      "schema": "Application",
      "description": "Tracked applications"
    },
    "/users/{userId}/scan_logs/{logId}": {
      "schema": "ScanLog",
      "description": "History of search engine runs"
    }
  }
}
